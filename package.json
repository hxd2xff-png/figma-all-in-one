{
  "name": "figma-all-in-one",
  "version": "0.1.0",
  "private": true,
  "description": "四合一 Figma 插件：字体混排 + 批量样式 + 斜切 + 导出压缩",
  "scripts": {
    "build": "node esbuild.config.js",
    "watch": "node esbuild.config.js --watch",
    "verify": "node scripts/verify-build.js",
    "test:skew": "esbuild src/features/skew.ts --bundle --format=cjs --platform=node --outfile=scripts/.skew.cjs --log-level=warning && node scripts/test-skew.js",
    "test:export": "esbuild src/features/export-compress.ts --bundle --format=cjs --platform=node --outfile=scripts/.export.cjs --log-level=warning && node scripts/test-export-path.js",
    "test:gradient": "esbuild src/features/bulk-styles.ts --bundle --format=cjs --platform=node --outfile=scripts/.bulk.cjs --log-level=warning && node scripts/test-gradient.js",
    "test:fontmix": "esbuild src/features/font-mixer.ts --bundle --format=cjs --platform=node --outfile=scripts/.fontmix.cjs --log-level=warning && node scripts/test-font-mixer.js",
    "check": "tsc --noEmit && node esbuild.config.js && node scripts/verify-build.js && npm run test:skew && npm run test:export && npm run test:gradient && npm run test:fontmix"
  },
  "devDependencies": {
    "@figma/plugin-typings": "^1.0.0",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.5"
  }
}
